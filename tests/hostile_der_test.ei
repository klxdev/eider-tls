// Hostile certificates, DER, PEM and key files: every prefix and every single-byte change of
// the real certificates, hand-made DER that breaks a rule of X.690, deep nesting, and
// garbage. Nothing may trap; parse results are counted.

import std.bytes
import std.fs
import std.io
import tls.asn1
import tls.keyfile
import tls.pem
import tls.wire
import tls.x509

type Rng = { s: u64 }

fn next(inout r: Rng) -> u64 {
    r.s = r.s *% 6364136223846793005 +% 1442695040888963407
    r.s >> 33
}

fn below(inout r: Rng, n: usize) -> usize { (next(inout r) % (n as u64)) as usize }

fn load(name: str) -> List[u8] uses fs {
    let mut p = "tests/pki/".bytes()
    bytes.append(inout p, name.bytes())
    fs.read(p).unwrap()
}

fn der_of(name: str) -> List[u8] uses fs {
    let blocks = pem.decode_all(load(name)).unwrap()
    blocks[0].der.copy()
}

fn yn(b: bool) -> str { if b { "yes" } else { "no" } }

fn der_case(label: str, hexs: str) uses io {
    let b = wire.hex(hexs)
    let mut d = asn1.reader(b)
    match asn1.next(inout d) {
        Some(t) => print("{label}: element tag {t.tag}, content {t.end - t.start} bytes")
        None => print("{label}: rejected")
    }
}

fn time_case(tag: u8, text: str) uses io {
    let mut b: List[u8] = List.new()
    b.push(tag)
    b.push(text.bytes().len() as u8)
    bytes.append(inout b, text.bytes())
    let mut d = asn1.reader(b)
    let t = asn1.next(inout d).unwrap()
    match asn1.time(d, t) {
        Some(s) => print("time {text}: {s}")
        None => print("time {text}: rejected")
    }
}

fn mutations(name: str) uses io, fs {
    let der = der_of(name)
    let mut r = Rng(7)
    let mut prefixes_ok = 0
    let mut k: usize = 0
    while k < der.len() {
        if x509.parse(wire.slice(der, 0, k)).is_ok() { prefixes_ok += 1 }
        k += 1
    }
    let mut changed_ok = 0
    let mut changed = 0
    let masks: [u8; 3] = [1, 128, 255]
    let mut i: usize = 0
    while i < der.len() {
        for m in masks {
            let mut bad = der.copy()
            bad[i] = bad[i] ^ m
            changed += 1
            if x509.parse(bad).is_ok() { changed_ok += 1 }
        }
        i += 1
    }
    // deletions and insertions of one byte at every position
    let mut shifted_ok = 0
    i = 0
    while i < der.len() {
        let mut del = der.copy()
        del.remove(i)
        if x509.parse(del).is_ok() { shifted_ok += 1 }
        let mut ins = der.copy()
        ins.insert(i, below(inout r, 256) as u8)
        if x509.parse(ins).is_ok() { shifted_ok += 1 }
        i += 1
    }
    let mut trailing = der.copy()
    trailing.push(0)
    print("{name}: {der.len()} bytes; prefixes parsed {prefixes_ok}; of {changed} one-byte changes {changed_ok} still parse; of {der.len() * 2} insertions/deletions {shifted_ok} parse; trailing byte parses {yn(x509.parse(trailing).is_ok())}")
}

fn main() uses io, fs {
    print("== real certificates, damaged")
    mutations("ed.pem")
    mutations("ec.pem")
    mutations("root.pem")
    mutations("inter.pem")

    print("== DER rules")
    der_case("empty", "")
    der_case("tag only", "30")
    der_case("zero length", "3000")
    der_case("short form", "0401aa")
    der_case("short form, content missing", "0402aa")
    der_case("indefinite length", "3080aa0000")
    der_case("long form for a short length", "048101aa")
    der_case("long form, 2 bytes, minimal", "048200800000")
    der_case("length with a leading zero byte", "04820001aa")
    der_case("length of 2^32 - 1", "0484ffffffff")
    der_case("length of 5 bytes", "048501000000aa")
    der_case("length 128 declared, 1 present", "048180aa")
    der_case("multi-byte tag", "1f0100")
    der_case("high tag number form", "3f8100")
    der_case("nested overrun", "3003040aaa")

    print("== times")
    time_case(23, "250101000000Z")
    time_case(23, "490101000000Z")
    time_case(23, "500101000000Z")
    time_case(24, "20250101000000Z")
    time_case(24, "99991231235959Z")
    time_case(23, "240229000000Z")
    time_case(23, "230229000000Z")
    time_case(23, "250101000000+0100")
    time_case(23, "2501010000Z")
    time_case(23, "251301000000Z")
    time_case(23, "250132000000Z")
    time_case(23, "250101240000Z")
    time_case(23, "250101006000Z")
    time_case(23, "25010100000aZ")
    time_case(24, "2025010100000Z")
    time_case(24, "20250101000000.5Z")
    time_case(4, "250101000000Z")

    print("== integers and booleans")
    let ints = ["020100", "02020080", "0202007f", "02020001", "0200", "02028000", "0205ffffffffff", "02050100000000", "020500ffffffff"]
    for h in ints {
        let b = wire.hex(h)
        let mut d = asn1.reader(b)
        let t = asn1.next(inout d).unwrap()
        let u = asn1.small_uint(d, t)
        print("INTEGER {h}: {u}")
    }
    let bools = ["0101ff", "010100", "010101", "0102ffff", "0100"]
    for h in bools {
        let b = wire.hex(h)
        let mut d = asn1.reader(b)
        let t = asn1.next(inout d).unwrap()
        let v = asn1.boolean(d, t)
        print("BOOLEAN {h}: {v}")
    }

    print("== nesting and garbage")
    // 100000 nested SEQUENCEs cannot be written with one-byte lengths, but a chain of
    // 3-byte headers can: the parser is not recursive, so its depth does not matter
    let mut deep: List[u8] = List.new()
    let mut depth: usize = 0
    while depth < 20000 {
        deep.push(48)
        deep.push(130)
        deep.push(255)
        deep.push(255)
        depth += 1
    }
    print("20000 nested headers: {yn(x509.parse(deep).is_ok())}")
    let mut r = Rng(99)
    let mut parsed = 0
    let mut n: usize = 0
    while n < 400 {
        let mut g: List[u8] = List.new()
        let mut j: usize = 0
        while j < n * 3 {
            g.push(below(inout r, 256) as u8)
            j += 1
        }
        if x509.parse(g).is_ok() { parsed += 1 }
        // a SEQUENCE header in front, so the parser gets further
        let mut h = wire.hex("3082")
        wire.put_u16(inout h, (g.len() & 65535) as u32)
        bytes.append(inout h, g)
        if x509.parse(h).is_ok() { parsed += 1 }
        n += 1
    }
    print("random garbage, 800 inputs: {parsed} parsed")

    print("== PEM")
    let cert = load("root.pem")
    let n1 = pem.decode_all(cert).unwrap().len()
    print("one block: {n1}")
    print("empty text: {pem.decode_all(List.new()).unwrap().len()}")
    let nb = pem.decode_all("hello\nworld\n".bytes()).unwrap().len()
    print("text without blocks: {nb}")
    let both = bytes.concat(cert, load("inter.pem"))
    print("two blocks: {pem.decode_all(both).unwrap().len()}")
    let mut crlf: List[u8] = List.new()
    for c in cert {
        if c == 10 { crlf.push(13) }
        crlf.push(c)
    }
    print("CRLF line ends: {pem.decode_all(crlf).unwrap().len()}")
    let mut cut = wire.slice(cert, 0, cert.len() - 30)
    print("no END line: {pem.decode_all(cut).is_ok()}")
    let mut badb64 = cert.copy()
    badb64[40] = 33
    print("a character outside base64: {pem.decode_all(badb64).is_ok()}")
    let mm = pem.decode_all("-----BEGIN A-----\nAAAA\n-----END B-----\n".bytes()).is_ok()
    print("mismatched END label: {mm}")
    let nd = pem.decode_all("-----BEGIN A\nAAAA\n".bytes()).is_ok()
    print("BEGIN without dashes: {nd}")
    let mut many: List[u8] = List.new()
    let mut q: usize = 0
    while q < 5000 {
        bytes.append(inout many, "-----BEGIN X-----\nAAAA\n-----END X-----\n".bytes())
        q += 1
    }
    print("5000 blocks: {pem.decode_all(many).is_ok()}")
    let enc = pem.encode("CERTIFICATE", der_of("root.pem"))
    let rt = bytes.eq(pem.decode_all(enc).unwrap()[0].der, der_of("root.pem"))
    print("encode then decode: {rt}")

    print("== key files")
    let ed = load("ed.key")
    let ec = load("ec.key")
    print("Ed25519 PKCS#8: {keyfile.from_pem(ed).is_ok()}")
    print("EC SEC1: {keyfile.from_pem(ec).is_ok()}")
    print("certificate is not a key: {keyfile.from_pem(cert).is_ok()}")
    let edder = pem.decode_all(ed).unwrap()[0].der.copy()
    let mut kp: usize = 0
    let mut kok = 0
    while kp < edder.len() {
        if keyfile.from_pkcs8(wire.slice(edder, 0, kp)).is_ok() { kok += 1 }
        let mut bad = edder.copy()
        bad[kp] = bad[kp] ^ 255
        if keyfile.from_pkcs8(bad).is_ok() { kok += 1 }
        kp += 1
    }
    print("Ed25519 key: prefixes and byte changes that still load: {kok}")
    let ecder = pem.decode_all(ec).unwrap()[0].der.copy()
    kp = 0
    kok = 0
    while kp < ecder.len() {
        if keyfile.from_sec1(wire.slice(ecder, 0, kp)).is_ok() { kok += 1 }
        let mut bad = ecder.copy()
        bad[kp] = bad[kp] ^ 255
        if keyfile.from_sec1(bad).is_ok() { kok += 1 }
        kp += 1
    }
    print("EC key: prefixes and byte changes that still load: {kok}")
}
