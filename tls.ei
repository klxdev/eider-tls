//! tls: TLS 1.3 (RFC 8446) for Eider, written in Eider over the crypto package's primitives.
//!
//! A client and a server handshake over any byte stream, the record layer, and X.509
//! certificate validation, each in a module of its own:
//!
//! - `tls.client` / `tls.server`: `connect(io, cfg, deadline)` and `accept(io, cfg, deadline)`
//!   run a handshake on a `stream.Reader + stream.Writer` and return a `tls.conn.Conn[S]`.
//! - `tls.conn`: the connection. It is itself a `stream.Reader` and `stream.Writer` (the
//!   application data), with `recv_by`/`send_by`/`try_recv` for deadlines, `close`,
//!   `update_keys`, the negotiated suite, ALPN protocol and the peer's certificates.
//! - `tls.config`: `client_config(host, roots)`, `server_config(identity)`, identities from PEM.
//! - `tls.x509`, `tls.pem`, `tls.asn1`, `tls.keyfile`: certificates, the trust store,
//!   chain and host name validation, PEM and DER, private keys.
//! - `tls.record`, `tls.handshake`, `tls.keys`, `tls.suite`, `tls.kex`, `tls.wire`,
//!   `tls.ct`, `tls.alert`: the layers underneath (docs/design.md).
//!
//! This module has the two shortcuts for TCP: `dial` and `accept_on`.
//!
//! ```
//! let roots = x509.system_store()?
//! let cfg = config.client_config("example.org", roots)
//! let mut c = tls.dial(addr, cfg, time.after_ms(10000))?
//! c.send_by("GET / HTTP/1.0\r\n\r\n".bytes(), time.after_ms(5000))?
//! let reply = c.recv_by(65536, time.after_ms(5000))?
//! ```

import std.net
import std.stream
import std.time
import tls.alert
import tls.client
import tls.config
import tls.conn
import tls.server

/// Connects to `addr` over TCP and runs the client handshake, all before `dl`. On failure the
/// socket is closed.
pub fn dial(addr: net.Addr, cfg: config.ClientConfig, dl: time.Deadline) -> Result[conn.Conn[stream.Fd], alert.Error] uses net, io, clock {
    let sock = match stream.connect_by(addr, dl) {
        Ok(s) => s
        Err(e) => return Err(alert.io_error(e))
    }
    match client.connect(sock, cfg, dl) {
        Ok(c) => Ok(c)
        Err(e) => {
            let z = sock.close()
            Err(e)
        }
    }
}

/// Accepts one TCP connection on `listener` (a listening socket from `net.listener`) and runs
/// the server handshake on it, all before `dl`. On failure the accepted socket is closed.
pub fn accept_on(listener: i32, cfg: config.ServerConfig, dl: time.Deadline) -> Result[conn.Conn[stream.Fd], alert.Error] uses net, io, clock {
    let a = match stream.accept_by(listener, dl) {
        Ok(a) => a
        Err(e) => return Err(alert.io_error(e))
    }
    match server.accept(a.fd, cfg, dl) {
        Ok(c) => Ok(c)
        Err(e) => {
            let z = a.fd.close()
            Err(e)
        }
    }
}
