//! tls.suite: the TLS 1.3 cipher suites this package implements (RFC 8446 section 9.1 asks for
//! TLS_AES_128_GCM_SHA256; the other two are the usual additions).

import crypto

pub type Suite = | Aes128GcmSha256 | Aes256GcmSha384 | ChaCha20Poly1305Sha256

pub const TLS_AES_128_GCM_SHA256: u32 = 4865
pub const TLS_AES_256_GCM_SHA384: u32 = 4866
pub const TLS_CHACHA20_POLY1305_SHA256: u32 = 4867

pub fn code(s: Suite) -> u32 {
    match s {
        Aes128GcmSha256 => 4865
        Aes256GcmSha384 => 4866
        ChaCha20Poly1305Sha256 => 4867
    }
}

pub fn of_code(c: u32) -> Option[Suite] {
    match c {
        4865 => Some(Aes128GcmSha256)
        4866 => Some(Aes256GcmSha384)
        4867 => Some(ChaCha20Poly1305Sha256)
        _ => None
    }
}

pub fn name(s: Suite) -> str {
    match s {
        Aes128GcmSha256 => "TLS_AES_128_GCM_SHA256"
        Aes256GcmSha384 => "TLS_AES_256_GCM_SHA384"
        ChaCha20Poly1305Sha256 => "TLS_CHACHA20_POLY1305_SHA256"
    }
}

pub fn hash(s: Suite) -> crypto.Hash {
    match s {
        Aes256GcmSha384 => crypto.Sha384
        _ => crypto.Sha256
    }
}

pub fn aead(s: Suite) -> crypto.Aead {
    match s {
        Aes128GcmSha256 => crypto.Aes128Gcm
        Aes256GcmSha384 => crypto.Aes256Gcm
        ChaCha20Poly1305Sha256 => crypto.ChaCha20Poly1305
    }
}

pub fn hash_len(s: Suite) -> usize { crypto.hash_len(hash(s)) }

/// The suites in the default order of preference for a client or server without a hardware
/// preference: ChaCha20-Poly1305 is not first (AES-GCM is what the hardware accelerates).
pub fn all() -> List[Suite] {
    let mut out: List[Suite] = List.new()
    out.push(Aes128GcmSha256)
    out.push(Aes256GcmSha384)
    out.push(ChaCha20Poly1305Sha256)
    out
}
